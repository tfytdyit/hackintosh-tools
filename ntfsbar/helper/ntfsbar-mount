#!/bin/bash
# ntfsbar-mount — NTFSBar 的提权助手
#   ntfsbar-mount mount <device> <volumeName>   把某个 NTFS 分区挂载为可读写
#   ntfsbar-mount unmount <mountPoint>          卸载
#   ntfsbar-mount auto                          把当前只读挂载的 NTFS 卷改成读写（开机自动调用）
#   ntfsbar-mount status                        打印环境与当前 NTFS 挂载
set -u

NTFS3G=/usr/local/bin/ntfs-3g
MOUNT_BIN=/sbin/mount
UMOUNT_BIN=/sbin/umount
DISKUTIL=/usr/sbin/diskutil

[ -x "$NTFS3G" ] || { echo "ntfs-3g not installed: $NTFS3G" >&2; exit 2; }

CONSOLE_USER=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || echo "")
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "loginwindow" ]; then
  CONSOLE_USER=$(/usr/bin/dscl . -list /Users UniqueID 2>/dev/null | /usr/bin/awk '$2>=501 && $2<600 {print $1; exit}')
fi
CONSOLE_UID=$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || echo 501)

mountline_for_mp() {
  "$MOUNT_BIN" | /usr/bin/grep -F " on $1 " | head -1
}

mp_of_dev() {
  # 挂载点可能带空格（/Volumes/Win11 Pro X64），不能用 awk 取第 3 列
  "$MOUNT_BIN" | /usr/bin/sed -n "s#^$1 on \(.*\) ([a-z0-9_,-]*\(,.*\)*)\$#\1#p" | head -1
}

unmount_mp() {
  local mp="$1"
  if [ -z "$mp" ]; then echo "missing mount point" >&2; return 2; fi
  if [ -z "$(mountline_for_mp "$mp")" ]; then
    echo "not mounted: $mp"
    return 0
  fi
  "$DISKUTIL" unmount "$mp" >/dev/null 2>&1
  local rc=$?
  if [ $rc -ne 0 ]; then
    "$UMOUNT_BIN" "$mp" >/dev/null 2>&1
    rc=$?
  fi
  if [ $rc -ne 0 ] && [ -n "$(mountline_for_mp "$mp")" ]; then
    "$UMOUNT_BIN" -f "$mp" >/dev/null 2>&1
    rc=$?
  fi
  local i=0
  while [ -n "$(mountline_for_mp "$mp")" ] && [ $i -lt 10 ]; do
    /bin/sleep 0.2
    i=$((i + 1))
  done
  if [ -n "$(mountline_for_mp "$mp")" ]; then
    echo "unmount failed (still mounted): $mp" >&2
    return 1
  fi
  echo "unmounted: $mp"
  return 0
}

mount_rw() {
  local dev="$1"
  local name="$2"
  if [ -z "$dev" ]; then echo "missing device" >&2; return 2; fi
  if [ -z "$name" ]; then name=$(/usr/bin/basename "$dev"); fi
  local mp="/Volumes/$name"

  local cur
  cur=$(mp_of_dev "$dev")
  if [ -n "$cur" ]; then
    unmount_mp "$cur" || { echo "cannot unmount existing mount: $cur" >&2; return 1; }
  fi
  if [ -n "$(mountline_for_mp "$mp")" ]; then
    unmount_mp "$mp" || { echo "mount point busy: $mp" >&2; return 1; }
  fi

  /bin/mkdir -p "$mp" 2>/dev/null
  "$NTFS3G" "$dev" "$mp" \
    -o local,allow_other,auto_xattr,noatime,volname="$name",uid="$CONSOLE_UID",gid=20
  local rc=$?
  if [ $rc -eq 0 ]; then
    echo "mounted read-write: $dev -> $mp"
  else
    echo "mount failed (rc=$rc): $dev" >&2
  fi
  return $rc
}

auto_mount() {
  # 只处理「系统以 ntfs 只读挂上」的卷；挂载点可能含空格（/Volumes/Win11 Pro X64），
  # 所以整行读进来再用 sed 抽挂载点，不能用 awk 取第 3 列。
  "$MOUNT_BIN" | /usr/bin/grep -E '\((ntfs|ufsd_NTFS),.*read-only' | while IFS= read -r line; do
    dev=$(echo "$line" | /usr/bin/awk '{print $1}')
    mp=$(echo "$line" | /usr/bin/sed -E 's#^.* on (.*) \((ntfs|ufsd_NTFS)[^)]*\).*$#\1#')
    [ -z "$mp" ] && continue
    [ "$mp" = "/" ] && continue
    name=$(/usr/bin/basename "$mp")
    [ "$name" = "Volumes" ] && continue
    mount_rw "$dev" "$name" || true
  done
}

case "${1:-}" in
  mount)   shift; mount_rw "${1:-}" "${2:-}" ;;
  unmount) shift; unmount_mp "${1:-}" ;;
  auto)    auto_mount ;;
  status)
    echo "ntfs-3g: $NTFS3G"
    "$NTFS3G" --version 2>&1 | head -1
    echo "console user: ${CONSOLE_USER:-?} (uid=$CONSOLE_UID)"
    # ntfs-3g 经 fuse-t 挂载时在 mount 里显示为 (nfs)，所以要一起列出来
    "$MOUNT_BIN" | /usr/bin/grep -Ei "ntfs|fuse-t:" || echo "(no NTFS mount)"
    ;;
  *)
    echo "usage: ntfsbar-mount {mount <device> <name>|unmount <mountPoint>|auto|status}" >&2
    exit 64
    ;;
esac
